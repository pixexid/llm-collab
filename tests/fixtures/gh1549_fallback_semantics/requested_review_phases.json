{
  "variant": "requested_review_phases",
  "description": "A request that EXISTS, at each point of its request-anchored flow. The other variants classify non-signals; this one classifies where a live request has got to, because collapsing every requested review to 'escalate' made a just-posted request, an expired initial request, an expired re-trigger and an already-raised escalation indistinguishable -- so the fixtures could certify a consumer that escalates immediately, one that skips the mandatory re-trigger, or one that reads its own escalation as terminal. Each phase is a REACHABLE case here rather than a shape an assertion forbids.",
  "project_cases": [
    {
      "project_id": "amiga",
      "tier": "A",
      "description": "A request naming the PRIOR head after a push. Stale, so nothing is pending for THIS head and the mandatory new-head request is owed.",
      "pr_state": {
        "head_oid": "amiga-abc200",
        "pr_open": true,
        "draft_ready": true,
        "explicit_review_request": true,
        "review_requests": [
          {
            "kind": "initial",
            "head_oid": "amiga-abc100",
            "phase": "expired"
          }
        ],
        "request_phase": "stale_for_this_head"
      },
      "artifacts_for_current_head": [],
      "expected": {
        "terminal_signal_present": false,
        "review_is_pending": false,
        "disposition": "gate_violation_request_required",
        "merge_eligible_on_silence": false
      }
    },
    {
      "project_id": "amiga",
      "tier": "A",
      "description": "Still inside the initial request's clock. Pending, and escalating here would skip the re-trigger the contract requires.",
      "pr_state": {
        "head_oid": "amiga-abc200",
        "pr_open": true,
        "draft_ready": true,
        "explicit_review_request": true,
        "review_requests": [
          {
            "kind": "initial",
            "head_oid": "amiga-abc200",
            "phase": "pending"
          }
        ],
        "request_phase": "initial_pending"
      },
      "artifacts_for_current_head": [],
      "expected": {
        "terminal_signal_present": false,
        "review_is_pending": true,
        "disposition": "wait_out_initial_request",
        "merge_eligible_on_silence": false
      }
    },
    {
      "project_id": "amiga",
      "tier": "A",
      "description": "The initial request's clock and the re-trigger's own clock are both spent, and the escalation is raised. The head stays blocked while the operator decision is pending; escalating again is not a next action.",
      "pr_state": {
        "head_oid": "amiga-abc200",
        "pr_open": true,
        "draft_ready": true,
        "explicit_review_request": true,
        "review_requests": [
          {
            "kind": "initial",
            "head_oid": "amiga-abc200",
            "phase": "expired"
          },
          {
            "kind": "re_trigger",
            "head_oid": "amiga-abc200",
            "phase": "expired"
          }
        ],
        "request_phase": "escalated_awaiting_disposition"
      },
      "artifacts_for_current_head": [],
      "expected": {
        "terminal_signal_present": false,
        "review_is_pending": true,
        "disposition": "blocked_pending_operator_disposition",
        "merge_eligible_on_silence": false
      }
    },
