{
  "variant": "eyes_only_current_head",
  "description": "The only artifact on the current head is an eyes reaction. The variant classifies a NON-signal: eyes is not a verdict, nothing terminal exists, and no elapsed time makes the head merge-eligible. What to DO about it follows from the tier and from whether a review was actually requested. A Tier A head with a request outstanding has a genuinely pending review, so continued silence is a stuck review to report and escalate -- never to merge through. A Tier B/C head with no request has nothing pending, so eyes changes nothing and there is no stuck review. Each project_cases entry pairs one tier with the disposition it actually produces, for amiga and for one non-Amiga project.",
  "project_cases": [
    {
      "project_id": "amiga",
      "tier": "A",
      "pr_state": {
        "head_oid": "amiga-abc200",
        "pr_open": true,
        "draft_ready": true,
        "explicit_review_request": true,
        "review_request_head_oid": "amiga-abc200"
      },
      "artifacts_for_current_head": [
        {
          "type": "reaction",
          "reaction": "eyes",
          "oid": "amiga-abc200"
        }
      ],
      "expected": {
        "terminal_signal_present": false,
        "review_is_pending": true,
        "disposition": "escalate_stuck_review",
        "merge_eligible_on_silence": false
      }
